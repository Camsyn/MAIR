; Where the trip count of a data-dependent loop comes from
; (docs/mair-loops.md, 数据相关的出口). A header induction variable is reused
; when its value at the exit gives the backedge-taken count BTC exactly: SCEV
; proves it does not wrap, or it is at least 64 bits wide and steps by one, so
; it wraps only after 2^64 iterations. Otherwise LPOC counts the backedges
; itself: backedges(%header) is a 64-bit counter that materialization inserts
; into the header, the way XSan inserts its loop counter.

; size_t i, no wrap flags, step 1: reused. The pointer has no flags either.
define i64 @reuse_i64(ptr %a) {
; CHECK-LABEL: define i64 @reuse_i64(
; CHECK-SAME: ptr [[A:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:  ; pp0: preds=[pp1(pdom)], succs=[pp1(dom)]
; CHECK-NEXT:  ; pp1: preds=[pp0(dom), pp7(pdom)], succs=[pp0(pdom), pp7(dom)]
; CHECK-NEXT:  ; pp7: loop-preheader=%[[LOOP:.*]], preds=[pp1(dom), pp8(pdom)], succs=[pp1(pdom), pp8(dom)]
; CHECK-NEXT:    br label %[[LOOP]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[INC:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ [[A]], %[[ENTRY]] ], [ [[P_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:  ; pp2: preds=[pp3(pdom)], succs=[pp3(dom)]
; CHECK-NEXT:  ; pp3: preds=[pp2(dom), pp4(pdom)], succs=[pp2(pdom), pp4(dom)]
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[P]], align 8
; CHECK-NEXT:    [[MORE:%.*]] = icmp sgt i64 [[V]], -1
; CHECK-NEXT:    [[P_NEXT]] = getelementptr i8, ptr [[P]], i64 8
; CHECK-NEXT:    [[INC]] = add i64 [[I]], 1
; CHECK-NEXT:  ; pp4: preds=[pp3(dom)], succs=[pp3(pdom)]
; CHECK-NEXT:    br i1 [[MORE]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:  ; pp5: preds=[pp8(dom), pp6(pdom)], succs=[pp8(pdom), pp6(dom)]
; CHECK-NEXT:  ; pp6: preds=[pp5(dom)], succs=[pp5(pdom)]
; CHECK-NEXT:  ; pp8: loop-exit=%[[LOOP]], preds=[pp5(pdom), pp7(dom)], succs=[pp5(dom), pp7(pdom)]
; CHECK-NEXT:  ; o: read period start=[[A]], stride=8, access-size=8, trips=(1 + zext([[I]] to i65)), align 8
; CHECK-NEXT:    ret i64 [[I]]
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %inc, %loop ]
  %p = phi ptr [ %a, %entry ], [ %p.next, %loop ]
  %v = load i64, ptr %p, align 8
  %more = icmp sgt i64 %v, -1
  %p.next = getelementptr i8, ptr %p, i64 8
  %inc = add i64 %i, 1
  br i1 %more, label %loop, label %exit

exit:
  ret i64 %i
}

