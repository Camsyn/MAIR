; A counter is inserted only for a trip count. Here %sp counts the inner loop.
; The start of the store, %d + j + 1, moves with the outer loop; the only
; other way to write it is through the inner recurrence %pn, which would need
; the backedges of the inner loop. No counter is inserted for that: the store
; stays in the loop.
define void @no_counter_for_start(ptr %d, ptr %s, i64 %n) {
; CHECK-LABEL: define void @no_counter_for_start(
; CHECK-SAME: ptr [[D:%.*]], ptr [[S:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:  ; pp0: preds=[pp1(pdom)], succs=[pp1(dom)]
; CHECK-NEXT:  ; pp1: preds=[pp0(dom), pp12(pdom)], succs=[pp0(pdom), pp12(dom)]
; CHECK-NEXT:  ; pp12: loop-preheader=%[[OUTER:.*]], preds=[pp1(dom), pp13(pdom)], succs=[pp1(pdom), pp13(dom)]
; CHECK-NEXT:    br label %[[OUTER]]
; CHECK:       [[OUTER]]:
; CHECK-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[J_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:  ; pp2: preds=[pp3(pdom)], succs=[pp3(dom)]
; CHECK-NEXT:    [[X:%.*]] = getelementptr inbounds nuw i8, ptr [[D]], i64 [[J]]
; CHECK-NEXT:  ; pp3: preds=[pp2(dom), pp14(pdom)], succs=[pp2(pdom), pp14(dom)]
; CHECK-NEXT:  ; pp14: loop-preheader=%[[LOOP:.*]], preds=[pp3(dom), pp15(pdom)], succs=[pp3(pdom), pp15(dom)]
; CHECK-NEXT:    br label %[[LOOP]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[PN:%.*]] = phi ptr [ [[X]], %[[OUTER]] ], [ [[DEST:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[SP:%.*]] = phi ptr [ [[S]], %[[OUTER]] ], [ [[S_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:  ; pp4: preds=[pp5(pdom)], succs=[pp5(dom)]
; CHECK-NEXT:    [[DEST]] = getelementptr inbounds nuw i8, ptr [[PN]], i64 1
; CHECK-NEXT:    [[S_NEXT]] = getelementptr inbounds nuw i8, ptr [[SP]], i64 1
; CHECK-NEXT:  ; pp5: preds=[pp4(dom), pp6(pdom)], succs=[pp4(pdom), pp6(dom)]
; CHECK-NEXT:    [[C:%.*]] = load i8, ptr [[SP]], align 1
; CHECK-NEXT:  ; pp6: preds=[pp5(dom), pp7(pdom)], succs=[pp5(pdom), pp7(dom)]
; CHECK-NEXT:  ; o: write ptr [[PN]] + 1, 1
; CHECK-NEXT:    store i8 [[C]], ptr [[DEST]], align 1
; CHECK-NEXT:    [[Z:%.*]] = icmp eq i8 [[C]], 0
; CHECK-NEXT:  ; pp7: preds=[pp6(dom)], succs=[pp6(pdom)]
; CHECK-NEXT:    br i1 [[Z]], label %[[OUTER_LATCH]], label %[[LOOP]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:  ; pp8: preds=[pp15(dom), pp9(pdom)], succs=[pp15(pdom), pp9(dom)]
; CHECK-NEXT:  ; pp15: loop-exit=%[[LOOP]], preds=[pp8(pdom), pp14(dom)], succs=[pp8(dom), pp14(pdom)]
; CHECK-NEXT:  ; o: read period start=[[S]], stride=1, access-size=1, trips=(1 + zext(((18446744073709551615 * ptrtoint([[X]] to i64)) + ptrtoint([[PN]] to i64)) to i65))
; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[J_NEXT]], [[N]]
; CHECK-NEXT:  ; pp9: preds=[pp8(dom)], succs=[pp8(pdom)]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[OUTER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:  ; pp10: preds=[pp13(dom), pp11(pdom)], succs=[pp13(pdom), pp11(dom)]
; CHECK-NEXT:  ; pp11: preds=[pp10(dom)], succs=[pp10(pdom)]
; CHECK-NEXT:  ; pp13: loop-exit=%[[OUTER]], preds=[pp10(pdom), pp12(dom)], succs=[pp10(dom), pp12(pdom)]
; CHECK-NEXT:    ret void
;
entry:
  br label %outer

outer:
  %j = phi i64 [ 0, %entry ], [ %j.next, %outer.latch ]
  %x = getelementptr inbounds nuw i8, ptr %d, i64 %j
  br label %loop

loop:
  %pn = phi ptr [ %x, %outer ], [ %dest, %loop ]
  %sp = phi ptr [ %s, %outer ], [ %s.next, %loop ]
  %dest = getelementptr inbounds nuw i8, ptr %pn, i64 1
  %s.next = getelementptr inbounds nuw i8, ptr %sp, i64 1
  %c = load i8, ptr %sp, align 1
  store i8 %c, ptr %dest, align 1
  %z = icmp eq i8 %c, 0
  br i1 %z, label %outer.latch, label %loop

outer.latch:
  %j.next = add nuw nsw i64 %j, 1
  %done = icmp eq i64 %j.next, %n
  br i1 %done, label %exit, label %outer

exit:
  ret void
}

