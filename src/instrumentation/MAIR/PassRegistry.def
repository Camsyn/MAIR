//===- PassRegistry.def - MAIR pass registry -------------------*- C++ -*-===//
//
// This file is intentionally included multiple times with different macro
// definitions, following LLVM's PassRegistry.def pattern.
//
//===----------------------------------------------------------------------===//

#ifndef MAIR_GRAPH_PASS
#define MAIR_GRAPH_PASS(NAME, CREATE_PASS)
#endif
#ifndef MAIR_GRAPH_ANALYSIS
#define MAIR_GRAPH_ANALYSIS(NAME, CREATE_PASS)
#endif

MAIR_GRAPH_ANALYSIS("stat", MAIRStatAnalysis())
MAIR_GRAPH_ANALYSIS("redundant-observation", RedundantObservationAnalysis())
// CREATE_PASS may use `Ordinal`, the N of a `NAME#N` pipeline entry (0 if
// absent), which only names the visit in `-mair-stats`.
MAIR_GRAPH_PASS("com", CommonObservationMotionPass(Ordinal))
MAIR_GRAPH_PASS("locationmerge", LocationMergePass(Ordinal))
MAIR_GRAPH_PASS("liom", LoopInvariantObservationMotionPass(
                            /*MergeEquivalentObservations=*/true, Ordinal))
MAIR_GRAPH_PASS("lpoc", LoopPeriodicObservationCombinePass(
                            /*MergeEquivalentObservations=*/true, Ordinal))
MAIR_GRAPH_PASS("obe", ObjectBoundsEliminationPass(Ordinal))
MAIR_GRAPH_PASS("roe", RedundantObservationEliminationPass(Ordinal))
MAIR_GRAPH_PASS("simplifygraph", SimplifyGraphPass(Ordinal))
MAIR_GRAPH_PASS("print<stat>", MAIRStatPrinterPass(errs()))

#undef MAIR_GRAPH_ANALYSIS
#undef MAIR_GRAPH_PASS
