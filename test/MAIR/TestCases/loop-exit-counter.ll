; CHECK-NEXT:    [[W_NEXT]] = add i32 [[W]], 1
; CHECK-NEXT:  ; pp7: preds=[pp6(dom), pp2(pdom iter %[[LOOP]])], succs=[pp6(pdom)]
; CHECK-NEXT:    br label %[[LOOP]]
; CHECK:       [[EXIT]]:
