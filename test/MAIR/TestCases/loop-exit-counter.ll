body:
  store i64 %v, ptr %q, align 8
  %k.next = getelementptr i8, ptr %k, i64 8
  %q.next = getelementptr i8, ptr %q, i64 8
  %h.next = add i16 %h, 1
  %w.next = add i32 %w, 1
