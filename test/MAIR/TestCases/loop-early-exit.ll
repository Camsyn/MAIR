; Loops that leave on a data-dependent test have no trip count SCEV can
; compute. An induction variable still tells at the exit how many iterations
; ran: its value there is Start + BTC * Step. LPOC reads the backedge-taken
; count BTC off that value and summarizes the source as for a computed count.
; The check moves to the exit, after the accesses; ASan may then see a SEGV
; before its report (docs/mair-loops.md).

; while (a[i] >= 0) i++: the load runs before the exit test, BTC + 1 times.
define void @until_neg(ptr %a, ptr %out) {
; CHECK-LABEL: define void @until_neg(
; CHECK-SAME: ptr [[A:%.*]], ptr [[OUT:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:  ; pp0: preds=[pp1(pdom)], succs=[pp1(dom)]
; CHECK-NEXT:  ; pp1: preds=[pp0(dom), pp8(pdom)], succs=[pp0(pdom), pp8(dom)]
; CHECK-NEXT:  ; pp8: loop-preheader=%[[LOOP:.*]], preds=[pp1(dom), pp9(pdom)], succs=[pp1(pdom), pp9(dom)]
; CHECK-NEXT:    br label %[[LOOP]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[INC:%.*]], %[[LOOP]] ]
; CHECK-NEXT:  ; pp2: preds=[pp3(pdom)], succs=[pp3(dom)]
; CHECK-NEXT:    [[PA:%.*]] = getelementptr inbounds nuw i64, ptr [[A]], i64 [[I]]
; CHECK-NEXT:  ; pp3: preds=[pp2(dom), pp4(pdom)], succs=[pp2(pdom), pp4(dom)]
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[PA]], align 8
; CHECK-NEXT:    [[MORE:%.*]] = icmp sgt i64 [[V]], -1
; CHECK-NEXT:    [[INC]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:  ; pp4: preds=[pp3(dom)], succs=[pp3(pdom)]
; CHECK-NEXT:    br i1 [[MORE]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:  ; pp5: preds=[pp9(dom), pp6(pdom)], succs=[pp9(pdom), pp6(dom)]
; CHECK-NEXT:  ; pp6: preds=[pp5(dom), pp7(pdom)], succs=[pp5(pdom), pp7(dom)]
; CHECK-NEXT:  ; o: write ptr [[OUT]], 8, align 8
; CHECK-NEXT:  ; pp9: loop-exit=%[[LOOP]], preds=[pp5(pdom), pp8(dom)], succs=[pp5(dom), pp8(pdom)]
; CHECK-NEXT:  ; o: read ptr [[A]], (8 + (8 * zext([[I]] to i67))), align 8
; CHECK-NEXT:    store i64 [[I]], ptr [[OUT]], align 8
; CHECK-NEXT:  ; pp7: preds=[pp6(dom)], succs=[pp6(pdom)]
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %inc, %loop ]
  %pa = getelementptr inbounds nuw i64, ptr %a, i64 %i
  %v = load i64, ptr %pa, align 8
  %more = icmp sgt i64 %v, -1
  %inc = add nuw nsw i64 %i, 1
  br i1 %more, label %loop, label %exit

exit:
  store i64 %i, ptr %out, align 8
  ret void
}

; The store runs after the exit test, once per backedge: BTC times, none if
; the first test leaves. The load still runs BTC + 1 times. The exit reads the
; induction variable through its LCSSA phi.
define i64 @store_after_test(ptr %a, ptr %b) {
; CHECK-LABEL: define i64 @store_after_test(
; CHECK-SAME: ptr [[A:%.*]], ptr [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:  ; pp0: preds=[pp1(pdom)], succs=[pp1(dom)]
; CHECK-NEXT:  ; pp1: preds=[pp0(dom), pp10(pdom)], succs=[pp0(pdom), pp10(dom)]
; CHECK-NEXT:  ; pp10: loop-preheader=%[[HEADER:.*]], preds=[pp1(dom), pp11(pdom)], succs=[pp1(pdom), pp11(dom)]
; CHECK-NEXT:    br label %[[HEADER]]
; CHECK:       [[HEADER]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[NEXT:%.*]], %[[BODY:.*]] ]
; CHECK-NEXT:  ; pp2: preds=[pp3(pdom)], succs=[pp3(dom), pp7(pdom iter %[[HEADER]])]
; CHECK-NEXT:    [[PA:%.*]] = getelementptr inbounds nuw i64, ptr [[A]], i64 [[I]]
; CHECK-NEXT:  ; pp3: preds=[pp2(dom), pp4(pdom)], succs=[pp2(pdom), pp4(dom)]
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[PA]], align 8
; CHECK-NEXT:    [[NEG:%.*]] = icmp slt i64 [[V]], 0
; CHECK-NEXT:  ; pp4: preds=[pp3(dom)], succs=[pp3(pdom), pp5(dom)]
; CHECK-NEXT:    br i1 [[NEG]], label %[[EXIT:.*]], label %[[BODY]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:  ; pp5: preds=[pp6(pdom), pp4(dom)], succs=[pp6(dom)]
; CHECK-NEXT:    [[PB:%.*]] = getelementptr inbounds nuw i64, ptr [[B]], i64 [[I]]
; CHECK-NEXT:  ; pp6: preds=[pp5(dom), pp7(pdom)], succs=[pp5(pdom), pp7(dom)]
; CHECK-NEXT:    store i64 1, ptr [[PB]], align 8
; CHECK-NEXT:    [[NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:  ; pp7: preds=[pp6(dom), pp2(pdom iter %[[HEADER]])], succs=[pp6(pdom)]
; CHECK-NEXT:    br label %[[HEADER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[I_LCSSA:%.*]] = phi i64 [ [[I]], %[[HEADER]] ]
; CHECK-NEXT:  ; pp8: preds=[pp11(dom), pp9(pdom)], succs=[pp11(pdom), pp9(dom)]
; CHECK-NEXT:  ; pp9: preds=[pp8(dom)], succs=[pp8(pdom)]
; CHECK-NEXT:  ; pp11: loop-exit=%[[HEADER]], preds=[pp8(pdom), pp10(dom)], succs=[pp8(dom), pp10(pdom)]
; CHECK-NEXT:  ; o: read ptr [[A]], (8 + (8 * zext([[I_LCSSA]] to i67))), align 8
; CHECK-NEXT:  ; o: write ptr [[B]], (8 * zext([[I_LCSSA]] to i66)), align 8
; CHECK-NEXT:    ret i64 [[I_LCSSA]]
;
entry:
  br label %header

header:
  %i = phi i64 [ 0, %entry ], [ %next, %body ]
  %pa = getelementptr inbounds nuw i64, ptr %a, i64 %i
  %v = load i64, ptr %pa, align 8
  %neg = icmp slt i64 %v, 0
  br i1 %neg, label %exit, label %body

body:
  %pb = getelementptr inbounds nuw i64, ptr %b, i64 %i
  store i64 1, ptr %pb, align 8
  %next = add nuw nsw i64 %i, 1
  br label %header

exit:
  %i.lcssa = phi i64 [ %i, %header ]
  ret i64 %i.lcssa
}

