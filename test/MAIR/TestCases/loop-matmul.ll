; CHECK-NEXT:    [[B_INDEX:%.*]] = mul nuw nsw i64 [[K]], [[N]]
; CHECK-NEXT:    [[B_ADDR:%.*]] = getelementptr [4 x i8], ptr [[B_COL]], i64 [[B_INDEX]]
; CHECK-NEXT:  ; pp10: preds=[pp11(pdom), pp8(dom)], succs=[pp11(dom), pp8(pdom)]
; CHECK-NEXT:    [[B_VAL:%.*]] = load float, ptr [[B_ADDR]], align 4
; CHECK-NEXT:    [[S_NEXT]] = tail call float @llvm.fmuladd.f32(float [[A_VAL]], float [[B_VAL]], float [[S]])
; CHECK-NEXT:    [[K_NEXT]] = add nuw nsw i64 [[K]], 1
; CHECK-NEXT:    [[K_DONE:%.*]] = icmp eq i64 [[K_NEXT]], [[N]]
; CHECK-NEXT:  ; pp11: preds=[pp10(dom)], succs=[pp10(pdom)]
; CHECK-NEXT:    br i1 [[K_DONE]], label %[[J_LATCH]], label %[[K_BODY]]
; CHECK:       [[J_LATCH]]:
; CHECK-NEXT:  ; pp12: preds=[pp26(dom), pp13(pdom)], succs=[pp26(pdom), pp13(dom)]
; CHECK-NEXT:  ; pp26: loop-exit=%[[K_BODY]], preds=[pp12(pdom), pp25(dom)], succs=[pp12(dom), pp25(pdom)]
; CHECK-NEXT:    [[C_ADDR:%.*]] = getelementptr [4 x i8], ptr [[C_ROW]], i64 [[J]]
; CHECK-NEXT:  ; pp13: preds=[pp12(dom), pp14(pdom)], succs=[pp12(pdom), pp14(dom)]
; CHECK-NEXT:    store float [[S_NEXT]], ptr [[C_ADDR]], align 4
; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
; CHECK-NEXT:    [[J_DONE:%.*]] = icmp eq i64 [[J_NEXT]], [[N]]
; CHECK-NEXT:  ; pp14: preds=[pp13(dom)], succs=[pp13(pdom)]
; CHECK-NEXT:    br i1 [[J_DONE]], label %[[I_LATCH]], label %[[J_HEADER]]
; CHECK:       [[I_LATCH]]:
; CHECK-NEXT:  ; pp15: preds=[pp24(dom), pp16(pdom)], succs=[pp24(pdom), pp16(dom)]
; CHECK-NEXT:  ; pp24: loop-exit=%[[J_HEADER]], preds=[pp15(pdom), pp23(dom)], succs=[pp15(dom), pp23(pdom)]
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[I_DONE:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:  ; pp16: preds=[pp15(dom)], succs=[pp15(pdom)]
; CHECK-NEXT:    br i1 [[I_DONE]], label %[[EXIT_LOOPEXIT:.*]], label %[[I_HEADER]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:  ; pp17: preds=[pp22(dom), pp18(pdom)], succs=[pp22(pdom), pp18(dom)]
; CHECK-NEXT:  ; pp18: preds=[pp17(dom), pp19(pdom)], succs=[pp17(pdom)]
; CHECK-NEXT:  ; pp22: loop-exit=%[[I_HEADER]], preds=[pp17(pdom), pp21(dom)], succs=[pp17(dom), pp21(pdom)]
; CHECK-NEXT:  ; o: read ptr [[A]], ((1 + zext((18446744073709551615 + [[N]]) to i131)) * (4 + (4 * zext((18446744073709551615 + [[N]]) to i131)))), align 4
; CHECK-NEXT:  ; o: write ptr [[C]], ((1 + zext((18446744073709551615 + [[N]]) to i131)) * (4 + (4 * zext((18446744073709551615 + [[N]]) to i131)))), align 4
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:  ; pp19: preds=[pp20(pdom), pp1(dom)], succs=[pp20(dom), pp1(pdom), pp18(pdom)]
; CHECK-NEXT:  ; pp20: preds=[pp19(dom)], succs=[pp19(pdom)]
; CHECK-NEXT:    ret void
;
entry:
  %enter = icmp sgt i64 %n, 0
  br i1 %enter, label %i.header, label %exit

i.header:
  %i = phi i64 [ %i.next, %i.latch ], [ 0, %entry ]
  %row = mul nuw nsw i64 %i, %n
  %a.row = getelementptr [4 x i8], ptr %A, i64 %row
  %c.row = getelementptr [4 x i8], ptr %C, i64 %row
  br label %j.header

j.header:
  %j = phi i64 [ 0, %i.header ], [ %j.next, %j.latch ]
  %b.col = getelementptr [4 x i8], ptr %B, i64 %j
  br label %k.body

k.body:
  %k = phi i64 [ 0, %j.header ], [ %k.next, %k.body ]
  %s = phi float [ 0.000000e+00, %j.header ], [ %s.next, %k.body ]
  %a.addr = getelementptr [4 x i8], ptr %a.row, i64 %k
  %a.val = load float, ptr %a.addr, align 4
  %b.index = mul nuw nsw i64 %k, %n
  %b.addr = getelementptr [4 x i8], ptr %b.col, i64 %b.index
  %b.val = load float, ptr %b.addr, align 4
  %s.next = tail call float @llvm.fmuladd.f32(float %a.val, float %b.val, float %s)
  %k.next = add nuw nsw i64 %k, 1
  %k.done = icmp eq i64 %k.next, %n
  br i1 %k.done, label %j.latch, label %k.body

j.latch:
  %c.addr = getelementptr [4 x i8], ptr %c.row, i64 %j
  store float %s.next, ptr %c.addr, align 4
  %j.next = add nuw nsw i64 %j, 1
  %j.done = icmp eq i64 %j.next, %n
  br i1 %j.done, label %i.latch, label %j.header

i.latch:
  %i.next = add nuw nsw i64 %i, 1
  %i.done = icmp eq i64 %i.next, %n
  br i1 %i.done, label %exit, label %i.header

exit:
  ret void
}

declare float @llvm.fmuladd.f32(float, float, float)
