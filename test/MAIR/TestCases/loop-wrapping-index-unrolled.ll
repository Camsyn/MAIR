; CHECK-NEXT:    [[POSITIVE:%.*]] = icmp sgt i32 [[N]], 0
; CHECK-NEXT:  ; pp1: preds=[pp0(dom), pp15(pdom)], succs=[pp0(pdom), pp2(dom), pp15(dom)]
