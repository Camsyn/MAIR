; CHECK-NEXT:    br label %[[LOOP]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ [[P_NEXT:%.*]], %[[LOOP]] ], [ [[B]], %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[SUM:%.*]] = phi i64 [ [[ADD:%.*]], %[[LOOP]] ], [ 0, %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:  ; pp4: preds=[pp5(pdom)], succs=[pp5(dom)]
; CHECK-NEXT:  ; pp5: preds=[pp4(dom), pp6(pdom)], succs=[pp4(pdom), pp6(dom)]
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[P]], align 8
; CHECK-NEXT:    [[ADD]] = add i64 [[V]], [[SUM]]
; CHECK-NEXT:    [[P_NEXT]] = getelementptr inbounds nuw i8, ptr [[P]], i64 8
; CHECK-NEXT:    [[AT_END:%.*]] = icmp eq ptr [[P_NEXT]], [[E]]
; CHECK-NEXT:  ; pp6: preds=[pp5(dom)], succs=[pp5(pdom)]
; CHECK-NEXT:    br i1 [[AT_END]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:  ; pp7: preds=[pp12(dom), pp8(pdom)], succs=[pp12(pdom), pp8(dom)]
; CHECK-NEXT:  ; pp8: preds=[pp7(dom), pp9(pdom)], succs=[pp7(pdom)]
; CHECK-NEXT:  ; pp12: loop-exit=%[[LOOP]], preds=[pp7(pdom), pp11(dom)], succs=[pp7(dom), pp11(pdom)]
; CHECK-NEXT:  ; o: read period start=[[B]], stride=8, access-size=8, trips=(1 + (zext(((18446744073709551608 + (18446744073709551615 * ptrtoint([[B]] to i64))) + ptrtoint([[E]] to i64)) to i65) udiv 8)), align 8
; CHECK-NEXT:    br label %[[DONE]]
; CHECK:       [[DONE]]:
; CHECK-NEXT:    [[R:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[ADD]], %[[EXIT]] ]
; CHECK-NEXT:  ; pp9: preds=[pp10(pdom), pp1(dom)], succs=[pp10(dom), pp1(pdom), pp8(pdom)]
; CHECK-NEXT:  ; pp10: preds=[pp9(dom)], succs=[pp9(pdom)]
; CHECK-NEXT:    ret i64 [[R]]
