entry:
  %positive = icmp sgt i32 %n, 0
  br i1 %positive, label %check, label %exit

check:
  %rest = and i32 %n, 3
  %short = icmp ult i32 %n, 4
  br i1 %short, label %epilogue.ph, label %unrolled.ph

unrolled.ph:
  %n4 = and i32 %n, 2147483644
  br label %unrolled

unrolled.exit:
