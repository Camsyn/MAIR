; CHECK-NEXT:  ; pp11: loop-exit=%[[LOOP]], preds=[pp8(pdom), pp10(dom)], succs=[pp8(dom), pp10(pdom)]
; CHECK-NEXT:  ; o: read period start=[[KEY]], stride=8, access-size=8, trips=(1 + zext(backedges(%[[LOOP]]) to i65)), align 8
; CHECK-NEXT:  ; o: write period start=[[D]], stride=8, access-size=8, trips=zext(backedges(%[[LOOP]]) to i65), align 8
; CHECK-NEXT:    [[HW:%.*]] = zext i16 [[H]] to i32
