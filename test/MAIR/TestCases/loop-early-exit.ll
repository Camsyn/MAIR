; CHECK-NEXT:  ; pp1: preds=[pp0(dom), pp9(pdom)], succs=[pp0(pdom), pp2(dom), pp9(dom)]
; CHECK-NEXT:    br i1 [[EMPTY]], label %[[DONE:.*]], label %[[LOOP_PREHEADER:.*]]
; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:  ; pp2: preds=[pp3(pdom), pp1(dom)], succs=[pp3(dom)]
