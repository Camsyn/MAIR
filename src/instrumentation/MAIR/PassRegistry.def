//===- PassRegistry.def - MAIR pass registry -------------------*- C++ -*-===//
//
// This file is intentionally included multiple times with different macro
// definitions, following LLVM's PassRegistry.def pattern.
//
//===----------------------------------------------------------------------===//

#ifndef MAIR_GRAPH_PASS
#define MAIR_GRAPH_PASS(NAME, CREATE_PASS)
#endif
#ifndef MAIR_GRAPH_ANALYSIS
#define MAIR_GRAPH_ANALYSIS(NAME, CREATE_PASS)
#endif

MAIR_GRAPH_ANALYSIS("stat", MAIRStatAnalysis())
MAIR_GRAPH_ANALYSIS("redundant-observation", RedundantObservationAnalysis())
MAIR_GRAPH_PASS("commonmamotion", CommonMAMotionPass())
MAIR_GRAPH_PASS("locationmerge", LocationMergePass())
MAIR_GRAPH_PASS("loop-invariant-observation-motion",
                LoopInvariantObservationMotionPass())
MAIR_GRAPH_PASS("loop-periodic-observation-combine",
                LoopPeriodicObservationCombinePass())
// RedundantObservationEliminationPass -> roe
MAIR_GRAPH_PASS("roe", RedundantObservationEliminationPass())
MAIR_GRAPH_PASS("simplifygraph", SimplifyGraphPass())
MAIR_GRAPH_PASS("print<stat>", MAIRStatPrinterPass(errs()))

#undef MAIR_GRAPH_ANALYSIS
#undef MAIR_GRAPH_PASS
