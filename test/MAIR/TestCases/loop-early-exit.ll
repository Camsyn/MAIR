; CHECK-NEXT:  ; pp8: loop-exit=%[[LOOP]], preds=[pp5(pdom), pp7(dom)], succs=[pp5(dom), pp7(pdom)]
; CHECK-NEXT:  ; o: read period start=[[S]], stride=8, access-size=8, trips=(1 + (zext(((18446744073709551615 * ptrtoint([[S]] to i64)) + ptrtoint([[P]] to i64)) to i65) udiv 8)), align 8
; CHECK-NEXT:    [[END:%.*]] = ptrtoint ptr [[P]] to i64
