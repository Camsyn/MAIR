; Negative: the unrolled loop of a prologue remainder starts at a symbolic k0.
; Copy j visits (k0 + j + 4m) & 255, which wraps below its start; the four
; together cover 4T indices from k0 modulo 256, no prefix from a.
define void @unrolled_from_k(ptr %a, i32 %k0, i32 %n4) {
; CHECK-LABEL: define void @unrolled_from_k(
; CHECK-SAME: ptr [[A:%.*]], i32 [[K0:%.*]], i32 [[N4:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:  ; pp0: preds=[pp1(pdom)], succs=[pp1(dom)]
; CHECK-NEXT:  ; pp1: preds=[pp0(dom), pp10(pdom)], succs=[pp0(pdom), pp10(dom)]
; CHECK-NEXT:  ; pp10: loop-preheader=%[[LOOP:.*]], preds=[pp1(dom), pp11(pdom)], succs=[pp1(pdom), pp11(dom)]
; CHECK-NEXT:    br label %[[LOOP]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[K:%.*]] = phi i32 [ [[K0]], %[[ENTRY]] ], [ [[K_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[C:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[C_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:  ; pp2: preds=[pp6(pdom)], succs=[pp6(dom)]
; CHECK-NEXT:    [[M0:%.*]] = and i32 [[K]], 255
; CHECK-NEXT:    [[I0:%.*]] = zext nneg i32 [[M0]] to i64
; CHECK-NEXT:    [[P0:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[I0]]
; CHECK-NEXT:    store i32 0, ptr [[P0]], align 4
; CHECK-NEXT:    [[K1:%.*]] = add i32 [[K]], 1
; CHECK-NEXT:    [[M1:%.*]] = and i32 [[K1]], 255
; CHECK-NEXT:    [[I1:%.*]] = zext nneg i32 [[M1]] to i64
; CHECK-NEXT:    [[P1:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[I1]]
; CHECK-NEXT:    store i32 1, ptr [[P1]], align 4
; CHECK-NEXT:    [[K2:%.*]] = add i32 [[K]], 2
; CHECK-NEXT:    [[M2:%.*]] = and i32 [[K2]], 255
; CHECK-NEXT:    [[I2:%.*]] = zext nneg i32 [[M2]] to i64
; CHECK-NEXT:    [[P2:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[I2]]
; CHECK-NEXT:    store i32 2, ptr [[P2]], align 4
; CHECK-NEXT:    [[K3:%.*]] = add i32 [[K]], 3
; CHECK-NEXT:    [[M3:%.*]] = and i32 [[K3]], 255
; CHECK-NEXT:    [[I3:%.*]] = zext nneg i32 [[M3]] to i64
; CHECK-NEXT:    [[P3:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[I3]]
; CHECK-NEXT:  ; pp6: preds=[pp7(pdom), pp2(dom)], succs=[pp7(dom), pp2(pdom)]
; CHECK-NEXT:  ; o: write ptr [[A]] + [[P0]], 4, align 4
; CHECK-NEXT:  ; o: write ptr [[A]] + [[P1]], 4, align 4
; CHECK-NEXT:  ; o: write ptr [[A]] + [[P2]], 4, align 4
; CHECK-NEXT:  ; o: write ptr [[A]] + [[P3]], 4, align 4
; CHECK-NEXT:    store i32 3, ptr [[P3]], align 4
; CHECK-NEXT:    [[K_NEXT]] = add i32 [[K]], 4
; CHECK-NEXT:    [[C_NEXT]] = add nuw nsw i32 [[C]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i32 [[C_NEXT]], [[N4]]
; CHECK-NEXT:  ; pp7: preds=[pp6(dom)], succs=[pp6(pdom)]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:  ; pp8: preds=[pp11(dom), pp9(pdom)], succs=[pp11(pdom), pp9(dom)]
; CHECK-NEXT:  ; pp9: preds=[pp8(dom)], succs=[pp8(pdom)]
; CHECK-NEXT:  ; pp11: loop-exit=%[[LOOP]], preds=[pp8(pdom), pp10(dom)], succs=[pp8(dom), pp10(pdom)]
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %k = phi i32 [ %k0, %entry ], [ %k.next, %loop ]
  %c = phi i32 [ 0, %entry ], [ %c.next, %loop ]
  %m0 = and i32 %k, 255
  %i0 = zext nneg i32 %m0 to i64
  %p0 = getelementptr inbounds i32, ptr %a, i64 %i0
  store i32 0, ptr %p0, align 4
  %k1 = add i32 %k, 1
  %m1 = and i32 %k1, 255
  %i1 = zext nneg i32 %m1 to i64
