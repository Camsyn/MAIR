; CHECK:       [[UNROLLED]]:
; CHECK-NEXT:    [[K:%.*]] = phi i32 [ 0, %[[UNROLLED_PH]] ], [ [[K_NEXT]], %[[UNROLLED]] ]
; CHECK-NEXT:    [[C:%.*]] = phi i32 [ 0, %[[UNROLLED_PH]] ], [ [[C_NEXT:%.*]], %[[UNROLLED]] ]
; CHECK-NEXT:  ; pp17: preds=[pp21(pdom)], succs=[pp21(dom)]
; CHECK-NEXT:    [[M0:%.*]] = and i32 [[K]], 252
; CHECK-NEXT:    [[I0:%.*]] = zext nneg i32 [[M0]] to i64
; CHECK-NEXT:    [[P0:%.*]] = getelementptr inbounds nuw [4 x i8], ptr [[A]], i64 [[I0]]
; CHECK-NEXT:    store i32 [[K]], ptr [[P0]], align 4
; CHECK-NEXT:    [[K1:%.*]] = or disjoint i32 [[K]], 1
; CHECK-NEXT:    [[M1:%.*]] = and i32 [[K1]], 253
; CHECK-NEXT:    [[I1:%.*]] = zext nneg i32 [[M1]] to i64
; CHECK-NEXT:    [[P1:%.*]] = getelementptr inbounds nuw [4 x i8], ptr [[A]], i64 [[I1]]
; CHECK-NEXT:    store i32 [[K1]], ptr [[P1]], align 4
; CHECK-NEXT:    [[K2:%.*]] = or disjoint i32 [[K]], 2
; CHECK-NEXT:    [[M2:%.*]] = and i32 [[K2]], 254
; CHECK-NEXT:    [[I2:%.*]] = zext nneg i32 [[M2]] to i64
; CHECK-NEXT:    [[P2:%.*]] = getelementptr inbounds nuw [4 x i8], ptr [[A]], i64 [[I2]]
; CHECK-NEXT:    store i32 [[K2]], ptr [[P2]], align 4
; CHECK-NEXT:    [[K3:%.*]] = or disjoint i32 [[K]], 3
; CHECK-NEXT:    [[M3:%.*]] = and i32 [[K3]], 255
; CHECK-NEXT:    [[I3:%.*]] = zext nneg i32 [[M3]] to i64
; CHECK-NEXT:    [[P3:%.*]] = getelementptr inbounds nuw [4 x i8], ptr [[A]], i64 [[I3]]
; CHECK-NEXT:  ; pp21: preds=[pp22(pdom), pp17(dom)], succs=[pp22(dom), pp17(pdom)]
; CHECK-NEXT:    store i32 [[K3]], ptr [[P3]], align 4
